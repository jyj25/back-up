# 자동 실행(autostart.sh) 이 읽는 설정. robot.env 로 복사해서 고친다 (robot.env 는 커밋 안 됨)
# 팀원 웹 주소들 (쉼표로 구분, 끝에 / 없이)
CORS_ORIGINS=http://localhost:8765
MAX_SPEED=150
OBSTACLE_CM=15
# AI 판정이 오면 자동 출발 (1 = 켜짐, 기본 꺼짐. 화면에서도 켤 수 있음)
AUTO_SORT=0
# 분류 보드 포트: auto = /dev/ttyACM* 자동, none = 안 씀
BOARD_PORT=auto
# 통 마커 설정 파일: 비우면 stations.json(인쇄 마커), 키트 블록(AprilTag 1~4번)으로 하려면 아래 줄 주석 해제
# STATIONS_FILE=stations.blocks.json
